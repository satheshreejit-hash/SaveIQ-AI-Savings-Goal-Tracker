# SaveIQ Environment Variables Example
# Duplicate this file as .env or configure in Google Apps Script Script Properties

# Google Apps Script Web App Deployment URL
# (Obtained after deploying Code.js as a Web App in Google Apps Script)
APPS_SCRIPT_WEB_APP_URL=https://script.google.com/macros/s/AKfycbx.../exec

# Groq Cloud API Key
# (Obtained from https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Groq Inference Model
GROQ_MODEL=llama-3.3-70b-versatile

# Alert Trigger Settings
DEADLINE_APPROACHING_DAYS=7
DEADLINE_CRITICAL_DAYS=3
